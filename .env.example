# --- Free sources (enabled by default, no API key needed) ---
# RSS feeds: Reuters, AP, CNBC, BBC, NPR, The Guardian
# Reddit: r/economics, r/wallstreetbets, r/geopolitics, etc.
# Set to false to disable:
# ENABLE_RSS=false
# ENABLE_REDDIT=false

# --- API-key sources (optional, sign up for free tiers) ---
#   NewsAPI.org   → https://newsapi.org/register     (100 req/day)
#   Finnhub       → https://finnhub.io/register      (60 req/min)
#   Alpha Vantage → https://www.alphavantage.co/support/#api-key (25 req/day)

NEWSAPI_KEY=
FINNHUB_KEY=
ALPHAVANTAGE_KEY=

# FRED API key (for economic indicators: inflation, GDP, rates, unemployment)
# Free at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_KEY=

# Hugging Face token (required for Inference API, free at https://huggingface.co/settings/tokens)
HF_TOKEN=

# Model to use (default: meta-llama/Llama-3.2-3B-Instruct)
# Other option: microsoft/Phi-3.5-mini-instruct
HF_MODEL=meta-llama/Llama-3.2-3B-Instruct

# Set to "local" to run the model on your machine (requires GPU + pip install .[local])
# Set to "api" to use the free HF Inference API (default, no GPU needed)
LLM_BACKEND=api
